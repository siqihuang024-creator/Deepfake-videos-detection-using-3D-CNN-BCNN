# Python / IDE
__pycache__/
.idea/
.vscode/
*.py[cod]

# Large archives. Result bundles downloaded off the GPU box live beside the
# code, so *.tgz has to be here too: without it `git add -A` sweeps every
# run's archive into the repository.
*.rar
*.zip
*.7z
*.tar
*.tar.gz
*.tgz
dfd_results

# Training outputs. Manifests are tracked on purpose: they define the identity
# split, and rebuilding them on another machine would silently change the
# protocol if that machine's dataset copy differs by even one file.
artifacts/*
!artifacts/manifests/
artifacts/manifests/*
!artifacts/manifests/*.csv
!artifacts/manifests/*.json
checkpoints/
models/
weights/
outputs/
results/
runs/
logs/
wandb/

# Model files
*.pt
*.pth
*.ckpt
*.onnx
*.h5
*.pkl
*.npy
*.npz

# Local machine paths (copy remote_env.example.sh and edit)
remote_env.sh
.env
